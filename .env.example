# Скопируй в .env и заполни значения. .env — в .gitignore.

# Имя стека (префикс контейнеров и сетей в compose)
COMPOSE_PROJECT_NAME=tnved

# Внешний порт хост-машины. Уже заняты: 8080 (kb-assistant), 8081 (zakupki-dashboard).
HOST_PORT=8082

# --- LLM-бэкенд (любой OpenAI-совместимый endpoint) ---
# OpenAI: oставь OPENAI_BASE_URL пустым (SDK сам поставит api.openai.com/v1)
# Внутренний шлюз / vLLM: укажи https://...
OPENAI_API_KEY=__set_me__
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Скопируй в .env и заполни значения. .env — в .gitignore.

# Имя стека (префикс контейнеров и сетей в compose)
COMPOSE_PROJECT_NAME=tnved

# Внешний порт хост-машины. Уже заняты: 8080 (kb-assistant), 8081 (zakupki-dashboard).
HOST_PORT=8082

# LITE_MODE=1 — пропускаем sentence-transformers + FAISS, используем только SQLite.
# Подходит для слабых серверов без KVM, где build_index.py может идти час+.
# Качество классификации ниже, но деплой работает за минуты.
LITE_MODE=0

# --- LLM-бэкенд (env используется как fallback, если в UI/заголовках пусто) ---
# Эти значения сработают, если юзер не настроил LLM в шестерёнке.
# В проде проще не задавать ключ в env, а заставить юзеров вводить свой через UI.
#
# OpenAI:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=                 # пусто = api.openai.com/v1; иначе vLLM/шлюз
#   LLM_MODEL=gpt-4o-mini
#
# Anthropic:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=claude-haiku-4-5

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

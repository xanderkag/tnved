# Скопируй в .env и заполни значения. .env — в .gitignore.

# Имя стека (префикс контейнеров и сетей в compose)
COMPOSE_PROJECT_NAME=tnved

# Внешний порт хост-машины — из реестра AgentMail/AGENTS.md (tnved_dev = 8110 с 25.09).
# Блок 8080–8099 на kb-docker занят целиком; 8084 отдан канарейке SLAI.
HOST_PORT=8110

# LITE_MODE=1 — пропускаем sentence-transformers + FAISS, используем только SQLite.
# Подходит для слабых серверов без KVM, где build_index.py может идти час+.
# Качество классификации ниже, но деплой работает за минуты.
LITE_MODE=0

# --- LLM: только наша модель на нашем железе (решение 25.09.2026) ---
# OpenAI-совместимый адрес vLLM во внутренней сети и имя модели, как его отдаёт
# GET <LLM_BASE_URL>/models. Значений по умолчанию нет: без них сервис не стартует,
# адрес вне внутренней сети — тоже. Выбора модели из UI и заголовков X-LLM-* нет.
# Переменные LLM_PROVIDER, OPENAI_*, ANTHROPIC_* больше не читаются — если заданы,
# сервис не стартует.
LLM_BASE_URL=
LLM_MODEL=
# Ключ, если vLLM запущен с --api-key; иначе пусто.
LLM_API_KEY=

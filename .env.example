# Скопируй в .env и заполни значения. .env — в .gitignore.

# Имя стека (префикс контейнеров и сетей в compose)
COMPOSE_PROJECT_NAME=tnved

# Внешний порт хост-машины — из реестра AgentMail/AGENTS.md (tnved_dev = 8110 с 25.09).
# Блок 8080–8099 на kb-docker занят целиком; 8084 отдан канарейке SLAI.
HOST_PORT=8110

# LITE_MODE=1 — без FAISS и векторов, кандидаты из SQLite.
# Только для проверки, что стек поднимается. Для прогонов и пилота НЕ годится:
# кандидаты — первые 120 листьев группы по порядку кода (нужный код в большой группе
# туда не попадает), промпт классификации — до 30k токенов при контексте модели 32k.
LITE_MODE=0

# --- LLM: только наша модель на нашем железе (решение 25.09.2026) ---
# OpenAI-совместимый адрес vLLM во внутренней сети и имя модели, как его отдаёт
# GET <LLM_BASE_URL>/models. Значений по умолчанию нет: без них сервис не стартует,
# адрес вне внутренней сети — тоже. Выбора модели из UI и заголовков X-LLM-* нет.
# Переменные LLM_PROVIDER, OPENAI_*, ANTHROPIC_* больше не читаются — если заданы,
# сервис не стартует.
# На kb-docker (25.09.2026): http://10.10.33.10:8100/v1, модель qwen36-vllm.
LLM_BASE_URL=
LLM_MODEL=
# Ключ, если vLLM запущен с --api-key; иначе пусто.
LLM_API_KEY=
# Секунд на один вызов, повторов нет. Замер 25.09: вызов 5–30 с (5 строк параллельно).
LLM_TIMEOUT=60
# Потолок ответа в токенах; обрезанный ответ — отказ. Замер 25.09: ответ до ~900 токенов.
LLM_MAX_TOKENS=2048
# Со схемой (classify): ответ до всех потолков полей — 1 047 токенов; обрыв — один повтор.
LLM_SCHEMA_MAX_TOKENS=1400

# --- Векторы: bge-m3 на нашем сервере (полный режим, LITE_MODE=0) ---
# Сюда уходит описание товара — адрес только во внутренней сети, как у LLM.
# Модель — та же, что собрала индекс: паспорт data/tnved_index_info.json
# ({"embedder":"api:bge-m3"}); не совпало — сервис не стартует.
# Без адреса полный режим не стартует (degraded, /health 503); на локальную e5
# сервис сам не переключается — её в образе нет, и индекс под неё не собран.
# На kb-docker: http://10.10.33.10:11434/v1 (vLLM, bge-m3). Индекс собран на Ollama
# 10.10.28.10:11434; сверка 25.09: косинус не ниже 0,9991, первый кандидат поиска
# совпал в 30 из 30 — пересборка не нужна. Паспорт сверяет только имя модели:
# сменили сервер — проверьте сами векторы: python check_embeddings.py
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=bge-m3
# Ключ, если сервер векторов его требует; Ollama — без ключа.
EMBEDDINGS_API_KEY=
# Секунд на запрос; 3 попытки, потом отказ 503 «Векторный поиск недоступен».
EMBEDDINGS_TIMEOUT=30
